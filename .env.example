# Stellar Testnet x402 only. Never use Mainnet keys here.
STELLAR_X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
STELLAR_X402_FACILITATOR_API_KEY=
X402_SELLER_ADDRESS=
X402_PAYER_SECRET=
X402_RESOURCE_BASE_URL=http://127.0.0.1:3210
X402_ENABLE_LOCAL_PAYER=false
EXTERNAL_QUOTE_BASE_URL=
RUN_EXTERNAL_X402_TESTNET=0

# Website Intelligence manual Testnet readiness. Public values only; no seeds.
WEBSITE_INTELLIGENCE_APPROVED_PAY_TO=
WEBSITE_INTELLIGENCE_APPROVED_CARD_HASH=
WEBSITE_INTELLIGENCE_LOCAL_BASE_URL=http://127.0.0.1:8787
WEBSITE_INTELLIGENCE_PUBLIC_RESOURCE_URL=

# Provider onboarding (publisher ingest). Shared secret for X-Bazaar-Provider-Key.
# Append-only, server-to-server and disabled by default. Requires all three values.
BAZAAR_ENABLE_REGISTRY_MUTATIONS=false
BAZAAR_PROVIDER_SECRET=

# Guarded provider draft intake. Ephemeral manual-review queue; disabled by default.
# Enabling this does NOT activate or add cards to public discovery.
BAZAAR_ENABLE_SELF_LISTING_INTAKE=false

# Registry persistence (Upstash Redis). If absent, in-memory fallback (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
