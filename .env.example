# Stellar Testnet x402 only. Never use Mainnet keys here.
STELLAR_X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
STELLAR_X402_FACILITATOR_API_KEY=
X402_SELLER_ADDRESS=
X402_PAYER_SECRET=
X402_RESOURCE_BASE_URL=http://127.0.0.1:3210
X402_ENABLE_LOCAL_PAYER=false
EXTERNAL_QUOTE_BASE_URL=
RUN_EXTERNAL_X402_TESTNET=0

# Website Intelligence manual Testnet readiness. Public values only; no seeds.
WEBSITE_INTELLIGENCE_APPROVED_PAY_TO=
WEBSITE_INTELLIGENCE_APPROVED_CARD_HASH=
WEBSITE_INTELLIGENCE_LOCAL_BASE_URL=http://127.0.0.1:8787
WEBSITE_INTELLIGENCE_PUBLIC_RESOURCE_URL=

# Provider onboarding (publisher ingest). Shared secret for X-Bazaar-Provider-Key.
# Append-only, server-to-server and disabled by default. Requires all three values.
BAZAAR_ENABLE_REGISTRY_MUTATIONS=false
BAZAAR_PROVIDER_SECRET=

# Guarded provider draft intake; disabled by default.
# Enabling this does NOT activate or add cards to public discovery.
BAZAAR_ENABLE_SELF_LISTING_INTAKE=false

# Shared provider review candidate. Dedicated credentials: no history aliases/fallback.
# File backend is restricted to local operation with an absolute private directory.
BAZAAR_PROVIDER_REVIEW_BACKEND=file
BAZAAR_PROVIDER_REVIEW_DIR=
BAZAAR_REVIEW_REDIS_REST_URL=
BAZAAR_REVIEW_REDIS_REST_TOKEN=
BAZAAR_REVIEW_PREFIX=bazaar-review:local-test
BAZAAR_REVIEW_RATE_SECRET=
BAZAAR_ENABLE_PUBLIC_PROVIDER_REVIEW=false
BAZAAR_ENABLE_PROVIDER_REVIEW_ADMIN=false
BAZAAR_ENABLE_PROVIDER_ACTIVATION=false

# Registry persistence (Upstash Redis). If absent, in-memory fallback (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Private operation history: server-only hashes, no raw tokens; no memory fallback.
# JSON array of {ownerId,readTokenHash,writeTokenHash}, SHA-256 lowercase hex.
# Give the human read access and the agent separate write access through a private channel.
BAZAAR_HISTORY_ACCOUNTS_JSON=

# Open private workspaces: independent namespace/backend, closed by default.
# Never reuse provider/admin/history credentials; only credential hashes persist.
BAZAAR_ENABLE_OPEN_WORKSPACES=false
BAZAAR_WORKSPACE_BACKEND=file
BAZAAR_WORKSPACE_PREFIX=bazaar-workspace:local-test
BAZAAR_WORKSPACE_FILE_DIRECTORY=
BAZAAR_WORKSPACE_LOCAL_ORIGIN=http://127.0.0.1:3282
BAZAAR_WORKSPACE_REDIS_REST_URL=
BAZAAR_WORKSPACE_REDIS_REST_TOKEN=
# Public pilot publication must explicitly select invite-only admission.
# Participants retain their own recovery token; configure only its SHA256 hash.
# One to five distinct hashes; removing a hash blocks creation/replay, not access
# administration. Revoke a workspace separately to invalidate existing access.
BAZAAR_WORKSPACE_ADMISSION=open
BAZAAR_WORKSPACE_INVITE_HASHES_JSON=
# Required for invite-only Redis; exact HTTPS origin, no trailing slash or path.
BAZAAR_WORKSPACE_PUBLIC_ORIGIN=
# Required in invite-only mode. Shared UTC minute/day quotas for authenticated
# workspace requests, not a cap on Redis commands or unauthenticated traffic.
BAZAAR_WORKSPACE_GLOBAL_REQUESTS_PER_MINUTE=
BAZAAR_WORKSPACE_GLOBAL_REQUESTS_PER_DAY=
# Pilot prefix: bazaar-workspace:pilot-<32 lowercase hex>, generated per pilot.
# File backend requires this exact loopback origin and is rejected on Vercel.
# A published environment requires explicit Redis configuration and capacity review.

# Private deliverable files (Cloudflare R2 - $0 Egress). Server-only; see docs/INTERACTIVE_DELIVERIES.md.
BAZAAR_S3_BUCKET=bazaar-deliverables
BAZAAR_S3_REGION=auto
BAZAAR_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
BAZAAR_S3_ACCESS_KEY_ID=
BAZAAR_S3_SECRET_ACCESS_KEY=
# Alternative R2 key aliases supported:
BAZAAR_S3_KEY_ID=
BAZAAR_S3_APP_KEY=

