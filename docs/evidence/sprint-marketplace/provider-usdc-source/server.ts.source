import * as dotenv from 'dotenv';
import { app } from './src/app.js';

dotenv.config();

const port = Number(process.env.PORT) || 3000;
const host = process.env.HOST || '0.0.0.0';

export const server = app.listen(port, host, () => {
  console.log(`====================================================`);
  console.log(` AI Video Scriptwriter & Creative Director x402`);
  console.log(` Server active on http://${host}:${port}`);
  console.log(` Endpoints:`);
  console.log(`   - POST /api/script        (0.02 USDC via x402)`);
  console.log(`   - POST /v1/script         (0.02 USDC via x402)`);
  console.log(`   - GET  /teleprompter      (Interactive UI)`);
  console.log(`   - GET  /api/service-card  (Service Card Manifest)`);
  console.log(`   - GET  /health            (Liveness & Readiness)`);
  console.log(`====================================================`);
});

export default server;
