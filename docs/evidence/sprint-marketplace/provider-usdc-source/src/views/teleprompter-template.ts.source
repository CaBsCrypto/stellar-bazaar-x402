        soundRhythm: 'Pleasant notification chime over upbeat music.',
        audioRhythm: { backgroundMusicVibe: 'Uplifting crescendo', sfx: ['Notification chime'], tempoBpm: 128 },
        pacingNote: 'Direct, unmistakable directive.',
      },
      {
        sceneNumber: 5,
        name: 'Infinite Loop Mechanism',
        sceneName: 'Infinite Loop Trigger',
        timeRange: '28-30s',
