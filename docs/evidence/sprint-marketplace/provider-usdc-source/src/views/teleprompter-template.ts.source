/**
 * Standalone Teleprompter Template Builder.
 * Generates zero-dependency, responsive HTML/CSS/JS viewer with 60fps auto-scroll,
 * real-time WPM speed control (80-260 WPM), Web Audio API 10-bar LED VU meter,
 * 3 high-contrast studio themes (Cyberpunk Neon, Matrix Terminal, High-Contrast Studio),
 * mirror mode (scaleX(-1)), fullscreen mode, studio keyboard shortcuts with HUD toast feedback,
 * 1-click multi-format exports (Markdown, TXT, JSON), and localStorage script receiver.
 */

import type { VideoScriptResult, ScriptScene } from '../engine/script-generator.js';

