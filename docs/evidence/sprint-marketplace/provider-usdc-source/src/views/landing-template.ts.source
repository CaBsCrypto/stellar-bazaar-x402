/**
 * Landing Page & Creator Studio Template Builder.
 * Cyberpunk Studio Glow aesthetic, zero-CDN architecture, interactive creative config form,
 * balanced 50/50 studio grid layout, inline scene editing with reactive word/WPM recalculation,
 * Web Speech API Text-to-Speech, multi-language switcher (ES/EN/PT) with dynamic chips,
 * multi-format export (.MD, .TXT, .JSON), robust 1-click script transfer to Teleprompter HUD,
 * and reactive x402 cURL builder.
 */

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

export function renderLandingPageHtml(): string {
  return `<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Video Scriptwriter & Creative Director · Stellar x402 Bazaar</title>
  <style>
    :root {
      --bg-color: #08090e;
      --bg-card: rgba(18, 20, 28, 0.78);
      --bg-card-hover: rgba(26, 30, 42, 0.88);
      --surface-border: rgba(255, 255, 255, 0.08);
      --surface-border-bright: rgba(6, 182, 212, 0.4);
      --text-color: #f8fafc;
      --text-muted: #94a3b8;
      --text-subtle: #64748b;
      --accent-cyan: #06b6d4;
      --accent-purple: #a855f7;
      --accent-yellow: #facc15;
      --accent-green: #22c55e;
      --accent-red: #ef4444;
      --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-color);
      font-family: var(--font-family);
      min-height: 100vh;
      overflow-x: hidden;
      line-height: 1.5;
      background-image:
        radial-gradient(circle at 15% 10%, rgba(6, 182, 212, 0.12) 0%, transparent 45%),
        radial-gradient(circle at 85% 20%, rgba(168, 85, 247, 0.14) 0%, transparent 50%),
        radial-gradient(circle at 50% 80%, rgba(250, 204, 21, 0.06) 0%, transparent 60%);
    }

    /* Container */
    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Header / Navbar */
    header.site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(8, 9, 14, 0.85);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--surface-border);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
    }

    .brand-logo-glow {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 20px rgba(6, 182, 212, 0.4);
      color: #000;
      font-weight: 900;
      font-size: 18px;
    }

    .brand-text h1 {
      font-size: 17px;
      font-weight: 800;
      letter-spacing: -0.3px;
      background: linear-gradient(90deg, #fff, #94a3b8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .brand-text p {
      font-size: 11px;
      color: var(--accent-cyan);
      font-weight: 600;
      letter-spacing: 0.8px;
      text-transform: uppercase;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .nav-link {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
      padding: 6px 12px;
      border-radius: 6px;
      transition: color 0.15s, background 0.15s;
    }

    .nav-link:hover {
      color: var(--text-color);
      background: rgba(255, 255, 255, 0.05);
    }

    .nav-badge-pill {
      background: rgba(6, 182, 212, 0.1);
      border: 1px solid rgba(6, 182, 212, 0.3);
      color: var(--accent-cyan);
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .nav-badge-pill .pulse-dot {
      width: 7px;
      height: 7px;
      background-color: var(--accent-cyan);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--accent-cyan);
      animation: pulse-glow 2s infinite ease-in-out;
    }

    @keyframes pulse-glow {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    /* Hero Section */
    section.hero {
      padding: 44px 0 28px;
      text-align: center;
    }

    .hero-badges {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 16px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .hero-badge {
      font-size: 12px;
      font-weight: 700;
      padding: 5px 12px;
      border-radius: 9999px;
      letter-spacing: 0.4px;
    }

    .hero-badge.cyan {
      background: rgba(6, 182, 212, 0.12);
      border: 1px solid rgba(6, 182, 212, 0.35);
      color: var(--accent-cyan);
    }

    .hero-badge.purple {
      background: rgba(168, 85, 247, 0.12);
      border: 1px solid rgba(168, 85, 247, 0.35);
      color: var(--accent-purple);
    }

    .hero-badge.yellow {
      background: rgba(250, 204, 21, 0.12);
      border: 1px solid rgba(250, 204, 21, 0.35);
      color: var(--accent-yellow);
    }

    .hero-title {
      font-size: clamp(28px, 4vw, 44px);
      font-weight: 900;
      line-height: 1.15;
      letter-spacing: -0.8px;
      margin-bottom: 12px;
    }

    .hero-title .glow-text {
      background: linear-gradient(135deg, #06b6d4 0%, #a855f7 50%, #facc15 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-description {
      font-size: 15px;
      color: var(--text-muted);
      max-width: 680px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Toast Notification */
    #toast-notification {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: rgba(18, 20, 28, 0.95);
      border: 1px solid var(--accent-cyan);
      box-shadow: 0 0 20px rgba(6, 182, 212, 0.4);
      color: #fff;
      padding: 12px 18px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      z-index: 1000;
      display: flex;
      align-items: center;
      gap: 10px;
      transform: translateY(100px);
      opacity: 0;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }

    #toast-notification.active {
      transform: translateY(0);
      opacity: 1;
    }

    /* Main Studio Grid - Balanced 1fr 1fr distribution */
    .studio-grid {
      display: grid;
      grid-template-columns: minmax(380px, 1fr) minmax(420px, 1.25fr);
      gap: 28px;
      margin-bottom: 48px;
      align-items: stretch;
    }

    @media (max-width: 980px) {
      .studio-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Glass Card Standard */
    .glass-card {
      background: var(--bg-card);
      border: 1px solid var(--surface-border);
      border-radius: 16px;
      padding: 24px;
      backdrop-filter: blur(16px);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
      display: flex;
      flex-direction: column;
    }

    .glass-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--surface-border);
      gap: 12px;
      flex-wrap: wrap;
    }

    .card-title-group {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .card-icon {
      font-size: 20px;
    }

    .card-title {
      font-size: 16px;
      font-weight: 800;
      color: #fff;
      letter-spacing: -0.2px;
    }

    .card-subtitle {
      font-size: 12px;
      color: var(--text-subtle);
    }

    /* Form Elements */
    .form-group {
      margin-bottom: 18px;
    }

    .form-label {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 8px;
      letter-spacing: 0.3px;
      text-transform: uppercase;
    }

    .label-aside {
      color: var(--accent-cyan);
      font-weight: 600;
      text-transform: none;
    }

    .text-input {
      width: 100%;
      background: rgba(8, 9, 14, 0.8);
      border: 1px solid var(--surface-border);
      border-radius: 10px;
      padding: 12px 14px;
      color: #fff;
      font-size: 14px;
      font-family: inherit;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .text-input:focus {
      border-color: var(--accent-cyan);
      box-shadow: 0 0 16px rgba(6, 182, 212, 0.25);
    }

    /* Language Switcher */
    .lang-switcher {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      margin-bottom: 8px;
    }

    .lang-btn {
      background: rgba(8, 9, 14, 0.6);
      border: 1px solid var(--surface-border);
      color: var(--text-muted);
      border-radius: 8px;
      padding: 8px 6px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      transition: all 0.15s ease;
    }

    .lang-btn:hover {
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
    }

    .lang-btn.active {
      background: rgba(6, 182, 212, 0.15);
      border-color: var(--accent-cyan);
      color: var(--accent-cyan);
      box-shadow: 0 0 12px rgba(6, 182, 212, 0.2);
    }

    /* Chips */
    .topic-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 10px;
    }

    .chip-btn {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--surface-border);
      border-radius: 6px;
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 600;
      padding: 5px 9px;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .chip-btn:hover {
      background: rgba(6, 182, 212, 0.1);
      border-color: rgba(6, 182, 212, 0.3);
      color: var(--accent-cyan);
    }

    /* Duration Slider */
    .duration-slider {
      width: 100%;
      height: 6px;
      border-radius: 3px;
      background: #1a1e2a;
      outline: none;
      -webkit-appearance: none;
      appearance: none;
      cursor: pointer;
    }

    .duration-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--accent-cyan);
      box-shadow: 0 0 12px var(--accent-cyan);
      cursor: pointer;
    }

    .slider-metrics {
      display: flex;
      justify-content: space-between;
      font-size: 10px;
      color: var(--text-subtle);
      margin-top: 6px;
      font-family: var(--font-mono);
    }

    /* Tone Selector Grid */
    .tone-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .tone-card {
      background: rgba(8, 9, 14, 0.6);
      border: 1px solid var(--surface-border);
      border-radius: 8px;
      padding: 10px 8px;
      text-align: center;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .tone-card:hover {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(255, 255, 255, 0.15);
    }

    .tone-card.selected {
      background: rgba(168, 85, 247, 0.15);
      border-color: var(--accent-purple);
      box-shadow: 0 0 16px rgba(168, 85, 247, 0.25);
    }

    .tone-icon {
      font-size: 16px;
      margin-bottom: 2px;
    }

    .tone-name {
      font-size: 11px;
      font-weight: 700;
      color: #fff;
    }

    .tone-desc {
      font-size: 9px;
      color: var(--text-subtle);
      margin-top: 2px;
    }

    /* Action Buttons */
    .btn-group {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: auto;
      padding-top: 16px;
    }

    .btn-primary-glow {
      background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
      color: #000;
      font-weight: 800;
      font-size: 14px;
      padding: 12px 18px;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
      box-shadow: 0 0 20px rgba(6, 182, 212, 0.35);
    }

    .btn-primary-glow:hover {
      box-shadow: 0 0 28px rgba(6, 182, 212, 0.55);
      transform: translateY(-1px);
    }

    .btn-tts-all {
      background: rgba(250, 204, 21, 0.12);
      color: var(--accent-yellow);
      border: 1px solid rgba(250, 204, 21, 0.4);
      font-weight: 700;
      font-size: 13px;
      padding: 10px 16px;
      border-radius: 10px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .btn-tts-all:hover {
      background: rgba(250, 204, 21, 0.22);
      border-color: var(--accent-yellow);
      box-shadow: 0 0 16px rgba(250, 204, 21, 0.3);
    }

    /* Header Actions */
    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .btn-tool-sm {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--surface-border);
      color: var(--text-muted);
      border-radius: 6px;
      padding: 5px 9px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: all 0.15s ease;
    }

    .btn-tool-sm:hover {
      background: rgba(255, 255, 255, 0.12);
      color: #fff;
    }

    .btn-launch-prompter {
      background: linear-gradient(135deg, var(--accent-purple), #ec4899);
      color: #fff;
      font-weight: 700;
      font-size: 12px;
      padding: 7px 14px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 0 16px rgba(168, 85, 247, 0.4);
      transition: all 0.2s ease;
    }

    .btn-launch-prompter:hover {
      box-shadow: 0 0 24px rgba(168, 85, 247, 0.6);
      transform: translateY(-1px);
    }

    /* Output Studio / Script Preview */
    .preview-container {
      display: flex;
      flex-direction: column;
      gap: 14px;
      height: 100%;
    }

    .script-header-card {
      background: rgba(8, 9, 14, 0.6);
      border: 1px solid var(--surface-border);
      border-radius: 10px;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }

    .meta-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .meta-label {
      font-size: 10px;
      color: var(--text-subtle);
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.5px;
    }

    .meta-value {
      font-size: 13px;
      font-weight: 700;
      color: var(--accent-yellow);
    }

    /* Scene Card */
    .scene-preview-card {
      background: rgba(8, 9, 14, 0.7);
      border: 1px solid var(--surface-border);
      border-radius: 12px;
      padding: 16px 18px;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
      position: relative;
    }

    .scene-preview-card:hover {
      border-color: rgba(255, 255, 255, 0.18);
    }

    .scene-preview-card.playing {
      border-color: var(--accent-yellow);
      box-shadow: 0 0 20px rgba(250, 204, 21, 0.2);
    }

    .scene-preview-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
      flex-wrap: wrap;
      gap: 8px;
    }

    .scene-badge-pill {
      font-size: 11px;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 4px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    .badge-s1 { background: rgba(6, 182, 212, 0.2); color: var(--accent-cyan); border: 1px solid rgba(6, 182, 212, 0.4); }
    .badge-s2 { background: rgba(168, 85, 247, 0.2); color: var(--accent-purple); border: 1px solid rgba(168, 85, 247, 0.4); }
    .badge-s3 { background: rgba(250, 204, 21, 0.2); color: var(--accent-yellow); border: 1px solid rgba(250, 204, 21, 0.4); }
    .badge-s4 { background: rgba(34, 211, 153, 0.2); color: var(--accent-green); border: 1px solid rgba(34, 211, 153, 0.4); }
    .badge-s5 { background: rgba(248, 113, 113, 0.2); color: var(--accent-red); border: 1px solid rgba(248, 113, 113, 0.4); }

    .scene-timing-badge {
      font-size: 11px;
      color: var(--text-muted);
      font-family: var(--font-mono);
    }

    .scene-actions-row {
      display: flex;
      gap: 6px;
    }

    .btn-scene-action {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--surface-border);
      color: var(--text-muted);
      border-radius: 4px;
      padding: 3px 7px;
      font-size: 11px;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .btn-scene-action:hover {
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
    }

    /* Editable Textarea */
    .scene-editor-box {
      width: 100%;
      background: rgba(0, 0, 0, 0.35);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 6px;
      padding: 8px 10px;
      color: #f8fafc;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.5;
      font-family: inherit;
      resize: vertical;
      min-height: 54px;
      outline: none;
      margin-bottom: 10px;
      transition: border-color 0.2s;
    }

    .scene-editor-box:focus {
      border-color: var(--accent-cyan);
      background: rgba(0, 0, 0, 0.6);
    }

    .scene-cues-row {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .cue-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      padding: 6px 10px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--surface-border);
      color: var(--text-muted);
    }

    .cue-pill.visual { border-left: 3px solid var(--accent-cyan); }
    .cue-pill.audio { border-left: 3px solid var(--accent-yellow); }

    /* Transfer Banner */
    .transfer-banner {
      background: linear-gradient(135deg, rgba(6, 182, 212, 0.1) 0%, rgba(168, 85, 247, 0.15) 100%);
      border: 1px solid rgba(168, 85, 247, 0.4);
      border-radius: 12px;
      padding: 16px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      margin-top: auto;
    }

    .transfer-text h4 {
      font-size: 14px;
      font-weight: 800;
      color: #fff;
      margin-bottom: 2px;
    }

    .transfer-text p {
      font-size: 12px;
      color: var(--text-muted);
    }

    /* Web3 & Transparency Hub */
    .transparency-section {
      margin-bottom: 60px;
    }

    .transparency-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }

    @media (max-width: 800px) {
      .transparency-grid {
        grid-template-columns: 1fr;
      }
    }

    .flow-steps {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 14px;
    }

    .flow-step {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      background: rgba(8, 9, 14, 0.6);
      border: 1px solid var(--surface-border);
      border-radius: 10px;
      padding: 12px 14px;
    }

    .step-number {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: rgba(6, 182, 212, 0.15);
      border: 1px solid var(--accent-cyan);
      color: var(--accent-cyan);
      font-weight: 800;
      font-size: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .step-content h5 {
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 2px;
    }

    .step-content p {
      font-size: 12px;
      color: var(--text-muted);
    }

    .code-box {
      background: #040508;
      border: 1px solid var(--surface-border);
      border-radius: 8px;
      padding: 12px;
      font-family: var(--font-mono);
      font-size: 11px;
      color: #93c5fd;
      overflow-x: auto;
      white-space: pre-wrap;
      word-break: break-all;
      position: relative;
    }

    .btn-copy-code {
      position: absolute;
      top: 8px;
      right: 8px;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid var(--surface-border);
      color: #fff;
      font-size: 10px;
      font-weight: 600;
      padding: 4px 8px;
      border-radius: 4px;
      cursor: pointer;
    }

    .btn-copy-code:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    /* Footer */
    footer.site-footer {
      border-top: 1px solid var(--surface-border);
      padding: 32px 0;
      text-align: center;
      font-size: 13px;
      color: var(--text-subtle);
    }

    .footer-links {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .footer-link {
      color: var(--text-muted);
      text-decoration: none;
      font-weight: 500;
    }

    .footer-link:hover {
      color: var(--accent-cyan);
    }
  </style>
</head>
<body>

  <!-- Toast Feedback -->
  <div id="toast-notification">
    <span id="toast-icon">✅</span>
    <span id="toast-msg">Mensaje</span>
  </div>

  <!-- Persistent Site Header -->
  <header class="site-header">
    <div class="container nav-inner">
      <a href="/" class="brand-group">
        <div class="brand-logo-glow">⚡</div>
        <div class="brand-text">
          <h1>AI Video Scriptwriter</h1>
          <p>Stellar x402 Bazaar Service</p>
        </div>
      </a>
      <nav class="nav-links">
        <div class="nav-badge-pill">
          <span class="pulse-dot"></span>
          <span>STELLAR:TESTNET · 0.02 USDC</span>
        </div>
        <a href="/teleprompter" class="nav-link">Studio Teleprompter</a>
        <a href="/api/service-card" class="nav-link" target="_blank">ServiceCard</a>
        <a href="/health" class="nav-link" target="_blank">Health</a>
      </nav>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-badges">
        <span class="hero-badge cyan">⚡ 0.02 USDC Micro-Payment</span>
        <span class="hero-badge purple">🛡 11/11 Bazaar Conformance</span>
        <span class="hero-badge yellow">🎬 High-Retention 5 Scenes</span>
      </div>
      <h2 class="hero-title">
        Guiones y Dirección Cinematográfica para <br>
        <span class="glow-text">TikTok, Reels & Shorts</span>
      </h2>
      <p class="hero-description">
        Estudio creativo de alta retención: ganchos de interrupción de patrón (0-3s), visual cues de edición,
        diseño sonoro y bucles infinitos. Monetizado en Stellar Testnet vía protocolo HTTP 402.
      </p>
    </div>
  </section>

  <!-- Interactive Creative Studio Grid -->
  <main class="container">
    <div class="studio-grid">
      
      <!-- Left Column: Interactive Form -->
      <section class="glass-card" id="config-card">
        <div class="glass-card-header">
          <div class="card-title-group">
            <span class="card-icon">🎛</span>
            <div>
              <h3 class="card-title">Parámetros del Video</h3>
              <p class="card-subtitle">Configura el tema, duración y voz narrativa</p>
            </div>
          </div>
          <span class="nav-badge-pill" style="font-size:10px;">x402 READY</span>
        </div>

        <form id="creative-form" onsubmit="return false;">
          
          <!-- Language Selector -->
          <div class="form-group">
            <div class="form-label">
              <span>Idioma / Language</span>
              <span class="label-aside" id="lang-indicator">Español</span>
            </div>
            <div class="lang-switcher">
              <button type="button" class="lang-btn active" data-lang="es">🇪🇸 ES</button>
              <button type="button" class="lang-btn" data-lang="en">🇺🇸 EN</button>
              <button type="button" class="lang-btn" data-lang="pt">🇧🇷 PT</button>
              <button type="button" class="lang-btn" data-lang="auto">🌐 Auto</button>
            </div>
          </div>

          <!-- Topic Input -->
          <div class="form-group">
            <div class="form-label">
              <span>Tema o Idea del Video</span>
              <span class="label-aside" id="topic-char-count">0 / 120</span>
            </div>
            <div class="input-wrapper">
              <input
                type="text"
                id="input-topic"
                class="text-input"
                placeholder="Ej: Micropagos en Stellar Blockchain y Protocolo x402"
                value="Micropagos en Stellar Blockchain y Protocolo x402"
                maxlength="120"
                required
              >
            </div>
            <!-- Suggestion Chips -->
            <div class="topic-chips" id="topic-chips-container">
              <!-- Dynamically rendered according to language -->
            </div>
          </div>

          <!-- Duration Range Slider -->
          <div class="form-group">
            <div class="form-label">
              <span>Duración Objetivo</span>
              <span class="label-aside" id="duration-readout">30 Segundos (~75 Palabras)</span>
            </div>
            <div class="slider-container">
              <input
                type="range"
                id="slider-duration"
                class="duration-slider"
                min="15"
                max="120"
                step="15"
                value="30"
              >
              <div class="slider-metrics">
                <span>15s (Viral)</span>
                <span>30s (Óptimo)</span>
                <span>60s (Estándar)</span>
                <span>120s (Profundo)</span>
              </div>
            </div>
          </div>

          <!-- Tone Selector -->
          <div class="form-group">
            <div class="form-label">
              <span>Tono Narrativo</span>
              <span class="label-aside" id="tone-readout">ENERGÉTICO</span>
            </div>
            <div class="tone-grid" id="tone-selector">
              <div class="tone-card selected" data-tone="energetic">
                <div class="tone-icon">⚡</div>
                <div class="tone-name">Energético</div>
                <div class="tone-desc">Ataque dinámico</div>
              </div>
              <div class="tone-card" data-tone="authoritative">
                <div class="tone-icon">👔</div>
                <div class="tone-name">Autoritario</div>
                <div class="tone-desc">Ejecutivo experto</div>
              </div>
              <div class="tone-card" data-tone="conversational">
                <div class="tone-icon">☕</div>
                <div class="tone-name">Cercano</div>
                <div class="tone-desc">De tú a tú</div>
              </div>
              <div class="tone-card" data-tone="dramatic">
                <div class="tone-icon">🎭</div>
                <div class="tone-name">Dramático</div>
                <div class="tone-desc">Alta tensión</div>
              </div>
              <div class="tone-card" data-tone="humorous">
                <div class="tone-icon">😄</div>
                <div class="tone-name">Humorístico</div>
                <div class="tone-desc">Ingenio relajado</div>
              </div>
              <div class="tone-card" data-tone="educational">
                <div class="tone-icon">🎓</div>
                <div class="tone-name">Educativo</div>
                <div class="tone-desc">Paso a paso</div>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div class="btn-group">
            <button type="button" id="btn-generate-free" class="btn-primary-glow">
              <span>⚡</span> Generar / Actualizar Guion
            </button>
            <button type="button" id="btn-speak-all" class="btn-tts-all">
              <span>🔊</span> Escuchar Guion Completo (TTS)
            </button>
          </div>
        </form>
      </section>

      <!-- Right Column: Live Script Studio Preview -->
      <section class="glass-card" id="output-card">
        <div class="glass-card-header">
          <div class="card-title-group">
            <span class="card-icon">🎬</span>
            <div>
              <h3 class="card-title" id="preview-title">Guion Estructurado</h3>
              <p class="card-subtitle" id="preview-subtitle">Haz click en cualquier texto para editarlo</p>
            </div>
          </div>
          <div class="header-actions">
            <button id="btn-export-md" class="btn-tool-sm" title="Descargar Markdown">
              <span>📝</span> .MD
            </button>
            <button id="btn-export-txt" class="btn-tool-sm" title="Descargar Texto">
              <span>📄</span> .TXT
            </button>
            <button id="btn-export-json" class="btn-tool-sm" title="Descargar JSON">
              <span>📦</span> .JSON
            </button>
            <button id="btn-quick-transfer" class="btn-launch-prompter" title="Abrir en teleprompter">
              <span>🚀</span> Teleprompter
            </button>
          </div>
        </div>

        <div class="preview-container">
          <!-- Metadata Bar -->
          <div class="script-header-card">
            <div class="meta-item">
              <span class="meta-label">Duración Est.</span>
              <span class="meta-value" id="meta-duration">30s</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Total Palabras</span>
              <span class="meta-value" id="meta-words">75 Palabras</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Velocidad (WPM)</span>
              <span class="meta-value" id="meta-pacing">150 WPM</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Tono Activo</span>
              <span class="meta-value" id="meta-tone-badge" style="color:var(--accent-purple);">ENERGÉTICO</span>
            </div>
          </div>

          <!-- Scenes Render Area (Editable) -->
          <div id="scenes-preview-list" style="display:flex; flex-direction:column; gap:12px;">
            <!-- Rendered by client JS -->
          </div>

          <!-- Transfer Banner -->
          <div class="transfer-banner">
            <div class="transfer-text">
              <h4>¿Listo para grabar frente a cámara?</h4>
              <p>Transfiere este guion con todas tus ediciones directamente al teleprompter profesional.</p>
            </div>
            <button id="btn-transfer-prompter" class="btn-launch-prompter">
              <span>🚀</span> Abrir en Teleprompter
            </button>
          </div>
        </div>
      </section>
    </div>

    <!-- Web3 & x402 Protocol Transparency Section -->
    <section class="transparency-section">
      <div class="transparency-grid">
        
        <!-- Left: Autonomous Agent Integration (cURL) -->
        <div class="glass-card">
          <div class="glass-card-header">
            <div class="card-title-group">
              <span class="card-icon">🤖</span>
              <div>
                <h3 class="card-title">Invocación para Agentes IA</h3>
                <p class="card-subtitle">cURL generado dinámicamente según tu formulario</p>
              </div>
            </div>
            <span class="nav-badge-pill" style="font-size:10px;">HTTP 402</span>
          </div>

          <p style="font-size:12px; color:var(--text-muted); margin-bottom:12px;">
            Los agentes de IA descubren e invocan este servicio pagando 0.02 USDC con firma criptográfica en el header <code style="color:var(--accent-cyan);">PAYMENT-SIGNATURE</code>.
          </p>

          <div class="code-box" id="curl-code-box">
            <button class="btn-copy-code" id="btn-copy-curl">Copiar cURL</button>
            <span id="curl-text-content">curl -X POST https://ai-video-scriptwriter.vercel.app/api/script ...</span>
          </div>

          <div style="margin-top:14px; display:flex; gap:8px; flex-wrap:wrap;">
            <a href="/api/service-card" target="_blank" class="btn-tool-sm" style="text-decoration:none;">
              📄 Ver ServiceCard Manifest
            </a>
            <a href="https://bazaar.browns.studio/#catalogo" target="_blank" class="btn-tool-sm" style="text-decoration:none;">
              🌐 Ver en Stellar Bazaar
            </a>
          </div>
        </div>

        <!-- Right: x402 Protocol Architecture -->
        <div class="glass-card">
          <div class="glass-card-header">
            <div class="card-title-group">
              <span class="card-icon">🛡</span>
              <div>
                <h3 class="card-title">Transparencia del Protocolo x402</h3>
                <p class="card-subtitle">Liquidación y entrega sellada criptográficamente</p>
              </div>
            </div>
            <span class="hero-badge purple" style="font-size:11px;">bazaar.delivery-envelope/v1</span>
          </div>

          <div class="flow-steps">
            <div class="flow-step">
              <div class="step-number">1</div>
              <div class="step-content">
                <h5>Desafío HTTP 402 (Quote)</h5>
                <p>La solicitud inicial responde con el encabezado Base64 <code>PAYMENT-REQUIRED</code> demandando 0.02 USDC a la wallet del proveedor.</p>
              </div>
            </div>
            <div class="flow-step">
              <div class="step-number">2</div>
              <div class="step-content">
                <h5>Micropago en Stellar Testnet</h5>
                <p>El agente comprador firma la transferencia de 0.02 USDC en Stellar Testnet hacia la dirección pública de cobro.</p>
              </div>
            </div>
            <div class="flow-step">
              <div class="step-number">3</div>
              <div class="step-content">
                <h5>Verificación y Entrega Sellada</h5>
                <p>El servidor verifica la transacción y devuelve el guion estructurado con su hash canónico SHA-256 (<code>resultHash</code>).</p>
              </div>
            </div>
          </div>

          <div style="margin-top:16px; font-size:11px; color:var(--text-subtle); display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px;">
            <span>Wallet: <code style="color:var(--text-muted);">GBYXQUSY...62LB</code></span>
            <span>Activo: <code style="color:var(--text-muted);">USDC (Stellar Testnet)</code></span>
          </div>
        </div>

      </div>
    </section>
  </main>

  <!-- Persistent Site Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-links">
        <a href="/" class="footer-link">Inicio</a>
        <a href="/teleprompter" class="footer-link">Teleprompter de Estudio</a>
        <a href="/api/service-card" class="footer-link">Ficha ServiceCard</a>
        <a href="/health" class="footer-link">Estado del Sistema</a>
        <a href="https://bazaar.browns.studio" target="_blank" rel="noopener noreferrer" class="footer-link">Stellar Bazaar</a>
      </div>
      <p>AI Video Scriptwriter & Creative Director · Impulsado por el Estándar HTTP x402 sobre Stellar Blockchain</p>
    </div>
  </footer>

  <!-- Client-Side Engine: Form Interactivity, Inline Editing, Speech Synthesis & Multi-Format Export -->
  <script>
    (function() {
      // 0. String Escaping Helper
      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      // 1. Language Suggestion Dictionary
      const langSuggestions = {
        es: [
          "Micropagos en Stellar Blockchain y Protocolo x402",
          "Economía de Agentes de IA que se pagan entre sí",
          "Por qué las comisiones de tarjetas destruyen el Micro-SaaS",
          "Streaming de Pagos Web3 vs Suscripciones Mensuales"
        ],
        en: [
          "Stellar Blockchain Micropayments & x402 Protocol",
          "Autonomous AI Agents Paying Each Other on Stellar",
          "Why Credit Card Processing Fees Kill Micro-SaaS",
          "Web3 Streaming Payments vs Monthly Subscriptions"
        ],
        pt: [
          "Micropagamentos na Blockchain Stellar e Protocolo x402",
          "Economia de Agentes de IA que pagam uns aos outros",
          "Por que as taxas de cartão destroem o Micro-SaaS",
          "Pagamentos Web3 Contínuos vs Assinaturas Mensais"
        ]
      };

      const toneStyles = {
        energetic: {
          wpm: 160,
          hookTactic: '0-3s Pattern Interrupt con crash-zoom y ataque directo',
          audioVibe: 'Synthwave electrónico con sub-graves potentes (128 BPM)',
          sfx: ['Impacto de bajo (Bass Drop)', 'Chime digital', 'Whoosh de cámara rápida'],
          loopLead: 'Y lo más increíble de todo este sistema es...'
        },
        authoritative: {
          wpm: 140,
          hookTactic: 'Llamado a la realidad audaz con encuadre fijo dramático',
          audioVibe: 'Pulso electrónico minimalista y seguro',
          sfx: ['Click sutil', 'Riser de tensión', 'Corte en seco'],
          loopLead: 'Lo que nos lleva directamente al motivo por el que empezamos...'
        },
        conversational: {
          wpm: 150,
          hookTactic: 'Pregunta empática cámara en mano al nivel de los ojos',
          audioVibe: 'Lo-fi cálido con ritmo suave y envolvente',
          sfx: ['Campanilla de notificación', 'Chasquido', 'Loop acústico'],
          loopLead: 'Y esa es exactamente la razón principal...'
        },
        dramatic: {
          wpm: 135,
          hookTactic: 'Advertencia de alto impacto con silencio y acercamiento lento',
          audioVibe: 'Pulso cinematográfico oscuro con tensión creciente',
          sfx: ['Boom cinematográfico profundo', 'Latido', 'Parada de cinta'],
          loopLead: 'La cuenta regresiva nunca se detiene porque...'
        },
        humorous: {
          wpm: 155,
          hookTactic: 'Verdad absurda con pausa cómica y congelado de imagen',
          audioVibe: 'Ritmo alegre y desenfadado con silencios cómicos',
          sfx: ['Scratch de disco', 'Pop sonoro', 'Slide whistle sutil'],
          loopLead: 'Y sí, estás a punto de caer exactamente en lo mismo...'
        },
        educational: {
          wpm: 145,
          hookTactic: 'Revelación paso a paso con infografía animada',
          audioVibe: 'Groove limpio de concentración con percusión nítida',
          sfx: ['Marcador sobre pizarra', 'Click de confirmación', 'Campana de resolución'],
          loopLead: 'Todo este diagrama conecta directamente con...'
        }
      };

      let currentLanguage = 'es';
      let selectedTone = 'energetic';
      let currentScript = null;

      // DOM Elements
      const inputTopic = document.getElementById('input-topic');
      const topicCharCount = document.getElementById('topic-char-count');
      const sliderDuration = document.getElementById('slider-duration');
      const durationReadout = document.getElementById('duration-readout');
      const toneReadout = document.getElementById('tone-readout');
      const metaToneBadge = document.getElementById('meta-tone-badge');
      const toneCards = document.querySelectorAll('.tone-card');
      const langBtns = document.querySelectorAll('.lang-btn');
      const topicChipsContainer = document.getElementById('topic-chips-container');
      const langIndicator = document.getElementById('lang-indicator');

      const btnGenerateFree = document.getElementById('btn-generate-free');
      const btnSpeakAll = document.getElementById('btn-speak-all');
      const btnTransferPrompter = document.getElementById('btn-transfer-prompter');
      const btnQuickTransfer = document.getElementById('btn-quick-transfer');

      const btnExportMd = document.getElementById('btn-export-md');
      const btnExportTxt = document.getElementById('btn-export-txt');
      const btnExportJson = document.getElementById('btn-export-json');

      const metaDuration = document.getElementById('meta-duration');
      const metaWords = document.getElementById('meta-words');
      const metaPacing = document.getElementById('meta-pacing');
      const previewTitle = document.getElementById('preview-title');
      const previewSubtitle = document.getElementById('preview-subtitle');
      const scenesPreviewList = document.getElementById('scenes-preview-list');
      const curlTextContent = document.getElementById('curl-text-content');
      const btnCopyCurl = document.getElementById('btn-copy-curl');

      const toast = document.getElementById('toast-notification');
      const toastMsg = document.getElementById('toast-msg');
      const toastIcon = document.getElementById('toast-icon');

      function showToast(msg, icon) {
        toastMsg.textContent = msg;
        toastIcon.textContent = icon || '✅';
        toast.classList.add('active');
        setTimeout(() => {
          toast.classList.remove('active');
        }, 2600);
      }

      // Render Chips for Language
      function renderTopicChips(lang) {
        const actualLang = lang === 'auto' ? 'es' : lang;
        const suggestions = langSuggestions[actualLang] || langSuggestions.es;
        topicChipsContainer.innerHTML = suggestions.map(topic => 
          '<button type="button" class="chip-btn" data-topic="' + escapeHtml(topic) + '">' + escapeHtml(topic) + '</button>'
        ).join('');

        topicChipsContainer.querySelectorAll('.chip-btn').forEach(btn => {
          btn.addEventListener('click', function() {
            inputTopic.value = this.getAttribute('data-topic');
            topicCharCount.textContent = inputTopic.value.length + ' / 120';
            renderCurrentGeneration();
            updateCurlSnippet();
          });
        });
      }

      // Language Switcher
      langBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          langBtns.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          currentLanguage = this.getAttribute('data-lang');
          langIndicator.textContent = this.textContent.trim();
          renderTopicChips(currentLanguage);
          
          // If topic is one of the default suggestions, replace with first chip in new language
          const actualLang = currentLanguage === 'auto' ? 'es' : currentLanguage;
          const firstTopic = langSuggestions[actualLang]?.[0];
          if (firstTopic) {
            inputTopic.value = firstTopic;
            topicCharCount.textContent = inputTopic.value.length + ' / 120';
          }
          renderCurrentGeneration();
          updateCurlSnippet();
        });
      });

      // Update Slider Readout
      function updateDurationReadout() {
        const val = parseInt(sliderDuration.value, 10);
        const style = toneStyles[selectedTone] || toneStyles.energetic;
        const words = Math.round((val / 60) * style.wpm);
        durationReadout.textContent = val + ' Segundos (~' + words + ' Palabras)';
        updateCurlSnippet();
      }

      sliderDuration.addEventListener('input', () => {
        updateDurationReadout();
        renderCurrentGeneration();
      });

      // Character Count
      inputTopic.addEventListener('input', function() {
        topicCharCount.textContent = inputTopic.value.length + ' / 120';
        updateCurlSnippet();
      });

      // Tone Selection
      toneCards.forEach(card => {
        card.addEventListener('click', function() {
          toneCards.forEach(c => c.classList.remove('selected'));
          this.classList.add('selected');
          selectedTone = this.getAttribute('data-tone') || 'energetic';
          toneReadout.textContent = selectedTone.toUpperCase();
          metaToneBadge.textContent = selectedTone.toUpperCase();
          updateDurationReadout();
          renderCurrentGeneration();
          updateCurlSnippet();
        });
      });

      // Script Generation Engine (Client Creator Studio)
      function generateDemoScript(topic, durationSeconds, tone, lang) {
        const style = toneStyles[tone] || toneStyles.energetic;
        const totalWords = Math.round((durationSeconds / 60) * style.wpm);

        const s1Words = Math.max(6, Math.round(totalWords * 0.12));
        const s2Words = Math.max(10, Math.round(totalWords * 0.20));
        const s3Words = Math.max(20, Math.round(totalWords * 0.48));
        const s4Words = Math.max(8, Math.round(totalWords * 0.14));
        const s5Words = Math.max(4, totalWords - (s1Words + s2Words + s3Words + s4Words));

        // Multilingual templates
        let hookText = '¡Detén el scroll ahora mismo si te interesa ' + topic + '!';
        let probText = 'La gran mayoría comete el error de abordar ' + topic + ' de la manera más lenta y costosa posible.';
        let valText = 'Esta es la clave para solucionarlo: Primero, elimina intermediarios innecesarios. Segundo, ejecuta con liquidación instantánea en segundos. Tercero, automatiza todo el flujo para que nunca dependa de procesos manuales.';
        let ctaText = '¡Guarda este video ahora mismo y comenta la palabra CLAVE para enviarte la guía paso a paso!';
        let loopText = style.loopLead;

        if (lang === 'en') {
          hookText = 'Stop scrolling right now if you care about ' + topic + '!';
          probText = 'Most people completely misunderstand ' + topic + ' and lose hours of effort doing it the old painful way.';
          valText = 'Here is the real blueprint: First, strip away the middlemen. Second, execute with sub-second finality. Third, automate the entire pipeline with cryptographic certainty.';
          ctaText = 'Save this video right now and drop a comment below to get the full step-by-step framework!';
          loopText = 'And that brings us right back to why...';
        } else if (lang === 'pt') {
          hookText = 'Pare de rolar o feed agora mesmo se você se importa com ' + topic + '!';
          probText = 'A maioria das pessoas comete o erro de lidar com ' + topic + ' da forma mais lenta e cara possível.';
          valText = 'Aqui está a chave prática: Primeiro, elimine intermediários. Segundo, liquide instantaneamente. Terceiro, automatize todo o processo com máxima segurança.';
          ctaText = 'Salve este vídeo agora mesmo e comente GUIA para receber o passo a passo completo!';
          loopText = 'E isso nos leva exatamente de volta ao início...';
        }

        const scenes = [
          {
            sceneNumber: 1,
            name: 'Gancho (0-3s)',
            timeRange: '0-3s',
            durationSeconds: Math.min(3, Math.round(durationSeconds * 0.1)),
            wordCount: s1Words,
            wpm: style.wpm,
            spokenScript: hookText,
            visualCue: 'Crash-zoom de cámara hacia primer plano (1.3x) con título en tipografía neón.',
            soundRhythm: style.sfx[0] + ' seguido de corte súbito al silencio.'
          },
          {
            sceneNumber: 2,
            name: 'Problema & Tensión',
            timeRange: '3-8s',
            durationSeconds: Math.round(durationSeconds * 0.17),
            wordCount: s2Words,
            wpm: style.wpm,
            spokenScript: probText,
            visualCue: 'Pantalla dividida mostrando el dolor del método tradicional vs la solución automatizada.',
            soundRhythm: 'Tic-tac de reloj en crescendo con sintetizador de fondo.'
          },
          {
            sceneNumber: 3,
            name: 'Puntos Clave de Valor',
            timeRange: '8-' + (durationSeconds - 6) + 's',
            durationSeconds: durationSeconds - 12,
            wordCount: s3Words,
            wpm: style.wpm,
            spokenScript: valText,
            visualCue: 'Cortes rápidos de B-Roll cada 2.5s con insignias numéricas [1], [2], [3] y subtítulos dinámicos.',
            soundRhythm: style.audioVibe + ' con sfx en cada revelación.'
          },
          {
            sceneNumber: 4,
            name: 'Llamado a la Acción (CTA)',
            timeRange: (durationSeconds - 6) + '-' + (durationSeconds - 2) + 's',
            durationSeconds: 4,
            wordCount: s4Words,
            wpm: style.wpm,
            spokenScript: ctaText,
            visualCue: 'Gesto directo apuntando al botón de guardar con resplandor verde animado.',
            soundRhythm: 'Notificación sonora nítida sobre acorde musical de resolución.'
          },
          {
            sceneNumber: 5,
            name: 'Bucle Infinito (Loop)',
            timeRange: (durationSeconds - 2) + '-' + durationSeconds + 's',
            durationSeconds: 2,
            wordCount: s5Words,
            wpm: style.wpm,
            spokenScript: loopText,
            visualCue: 'Whip-pan (paneo rápido con desenfoque) conectando la posición final con el inicio del video.',
            soundRhythm: 'Acorde suspendido que resuelve exactamente en el primer impacto de la Escena 1.'
          }
        ];

        return {
          topic: topic,
          durationSeconds: durationSeconds,
          tone: tone,
          targetWpm: style.wpm,
          totalWords: totalWords,
          estimatedDuration: durationSeconds,
          overallWPM: style.wpm,
          scenes: scenes
        };
      }

      // Recalculate word counts when user edits inline
      function recalculateMetrics() {
        if (!currentScript) {
          renderCurrentGeneration();
        }
        let totalWords = 0;
        currentScript.scenes.forEach((sc, idx) => {
          const textarea = document.getElementById('scene-edit-' + sc.sceneNumber);
          if (textarea) {
            sc.spokenScript = textarea.value;
            const words = sc.spokenScript.trim() ? sc.spokenScript.trim().split(/\\s+/).length : 0;
            sc.wordCount = words;
            totalWords += words;
            
            // update scene timing label
            const badge = document.getElementById('scene-time-' + sc.sceneNumber);
            if (badge) {
              badge.textContent = '⏱ ' + sc.timeRange + ' (' + sc.durationSeconds + 's · ' + words + ' pal)';
            }
          }
        });

        currentScript.totalWords = totalWords;
        const overallWpm = Math.round((totalWords / currentScript.durationSeconds) * 60);
        currentScript.overallWPM = overallWpm;

        metaWords.textContent = totalWords + ' Palabras';
        metaPacing.textContent = overallWpm + ' WPM';
      }

      // Render Scenes into DOM
      function renderScenes(script) {
        currentScript = script;
        previewTitle.textContent = script.topic;
        previewSubtitle.textContent = script.durationSeconds + 's · ' + script.tone.toUpperCase() + ' · ' + script.totalWords + ' palabras';
        metaDuration.textContent = script.durationSeconds + 's';
        metaWords.textContent = script.totalWords + ' Palabras';
        metaPacing.textContent = script.targetWpm + ' WPM';

        const badgeClasses = ['badge-s1', 'badge-s2', 'badge-s3', 'badge-s4', 'badge-s5'];

        scenesPreviewList.innerHTML = script.scenes.map((sc, idx) => {
          const badgeClass = badgeClasses[idx % badgeClasses.length];
          return '<div class="scene-preview-card" id="scene-card-' + sc.sceneNumber + '">' +
            '<div class="scene-preview-header">' +
              '<span class="scene-badge-pill ' + badgeClass + '">ESCENA ' + sc.sceneNumber + ': ' + sc.name.toUpperCase() + '</span>' +
              '<span class="scene-timing-badge" id="scene-time-' + sc.sceneNumber + '">⏱ ' + sc.timeRange + ' (' + sc.durationSeconds + 's · ' + sc.wordCount + ' pal)</span>' +
              '<div class="scene-actions-row">' +
                '<button type="button" class="btn-scene-action btn-speak-scene" data-scene="' + sc.sceneNumber + '" title="Escuchar Escena">🔊 Escuchar</button>' +
                '<button type="button" class="btn-scene-action btn-copy-scene" data-scene="' + sc.sceneNumber + '" title="Copiar texto">📋 Copiar</button>' +
              '</div>' +
            '</div>' +
            '<textarea class="scene-editor-box" id="scene-edit-' + sc.sceneNumber + '" data-scene="' + sc.sceneNumber + '" rows="2">' + escapeHtml(sc.spokenScript) + '</textarea>' +
            '<div class="scene-cues-row">' +
              '<div class="cue-pill visual"><span style="font-size:14px;">🎬</span><span>' + escapeHtml(sc.visualCue) + '</span></div>' +
              '<div class="cue-pill audio"><span style="font-size:14px;">🎵</span><span>' + escapeHtml(sc.soundRhythm) + '</span></div>' +
            '</div>' +
          '</div>';
        }).join('');

        // Attach Inline Edit Listeners
        document.querySelectorAll('.scene-editor-box').forEach(tx => {
          tx.addEventListener('input', recalculateMetrics);
        });

        // Attach Scene Copy Listeners
        document.querySelectorAll('.btn-copy-scene').forEach(btn => {
          btn.addEventListener('click', function() {
            const num = this.getAttribute('data-scene');
            const tx = document.getElementById('scene-edit-' + num);
            if (tx) {
              navigator.clipboard.writeText(tx.value).then(() => {
                showToast('Escena ' + num + ' copiada al portapapeles');
              });
            }
          });
        });

        // Attach Scene Speak Listeners
        document.querySelectorAll('.btn-speak-scene').forEach(btn => {
          btn.addEventListener('click', function() {
            const num = parseInt(this.getAttribute('data-scene'), 10);
            speakScene(num);
          });
        });
      }

      function renderCurrentGeneration() {
        const topic = inputTopic.value.trim() || 'Micropagos en Stellar Blockchain';
        const duration = parseInt(sliderDuration.value, 10) || 30;
        const tone = selectedTone || 'energetic';
        const script = generateDemoScript(topic, duration, tone, currentLanguage);
        renderScenes(script);
      }

      btnGenerateFree.addEventListener('click', () => {
        renderCurrentGeneration();
        showToast('Guion generado y listo para editar');
      });

      // Speech Synthesis (Web Speech API)
      let isSpeaking = false;

      function getVoiceForLang(langCode) {
        if (!('speechSynthesis' in window)) return null;
        const voices = window.speechSynthesis.getVoices();
        const target = langCode === 'en' ? 'en' : langCode === 'pt' ? 'pt' : 'es';
        return voices.find(v => v.lang.toLowerCase().startsWith(target)) || null;
      }

      function speakScene(sceneNumber) {
        if (!('speechSynthesis' in window)) {
          showToast('Tu navegador no soporta síntesis de voz', '⚠️');
          return;
        }

        window.speechSynthesis.cancel();
        document.querySelectorAll('.scene-preview-card').forEach(c => c.classList.remove('playing'));

        const card = document.getElementById('scene-card-' + sceneNumber);
        const tx = document.getElementById('scene-edit-' + sceneNumber);
        if (!tx) return;

        const utter = new SpeechSynthesisUtterance(tx.value);
        const voice = getVoiceForLang(currentLanguage);
        if (voice) utter.voice = voice;
        utter.rate = 1.05;

        if (card) card.classList.add('playing');

        utter.onend = () => {
          if (card) card.classList.remove('playing');
        };
        utter.onerror = () => {
          if (card) card.classList.remove('playing');
        };

        window.speechSynthesis.speak(utter);
      }

      function speakAllScript() {
        if (!('speechSynthesis' in window)) {
          showToast('Tu navegador no soporta síntesis de voz', '⚠️');
          return;
        }

        if (isSpeaking) {
          window.speechSynthesis.cancel();
          isSpeaking = false;
          btnSpeakAll.innerHTML = '<span>🔊</span> Escuchar Guion Completo (TTS)';
          document.querySelectorAll('.scene-preview-card').forEach(c => c.classList.remove('playing'));
          return;
        }

        recalculateMetrics();
        window.speechSynthesis.cancel();
        isSpeaking = true;
        btnSpeakAll.innerHTML = '<span>⏹</span> Detener Reproducción';

        const queue = [...currentScript.scenes];

        function playNext() {
          if (queue.length === 0 || !isSpeaking) {
            isSpeaking = false;
            btnSpeakAll.innerHTML = '<span>🔊</span> Escuchar Guion Completo (TTS)';
            document.querySelectorAll('.scene-preview-card').forEach(c => c.classList.remove('playing'));
            return;
          }

          const sc = queue.shift();
          const card = document.getElementById('scene-card-' + sc.sceneNumber);
          document.querySelectorAll('.scene-preview-card').forEach(c => c.classList.remove('playing'));
          if (card) card.classList.add('playing');

          const utter = new SpeechSynthesisUtterance(sc.spokenScript);
          const voice = getVoiceForLang(currentLanguage);
          if (voice) utter.voice = voice;
          utter.rate = 1.05;

          utter.onend = () => {
            if (card) card.classList.remove('playing');
            playNext();
          };
          utter.onerror = () => {
            if (card) card.classList.remove('playing');
            playNext();
          };

          window.speechSynthesis.speak(utter);
        }

        playNext();
      }

      btnSpeakAll.addEventListener('click', speakAllScript);

      // 1-Click Teleprompter Transfer (Guaranteed to work always)
      function transferToTeleprompter() {
        // 1. Ensure currentScript exists
        if (!currentScript) {
          renderCurrentGeneration();
        }
        
        // 2. Synchronize any edited textarea text into currentScript
        recalculateMetrics();

        // 3. Fallback check on topic and duration
        const topic = (currentScript && currentScript.topic) ? currentScript.topic : (inputTopic.value.trim() || 'Micropagos en Stellar');
        const duration = (currentScript && currentScript.durationSeconds) ? currentScript.durationSeconds : (parseInt(sliderDuration.value, 10) || 30);
        const tone = (currentScript && currentScript.tone) ? currentScript.tone : (selectedTone || 'energetic');

        // 4. Save to localStorage with fail-safe error handling
        try {
          localStorage.setItem('x402_teleprompter_script', JSON.stringify(currentScript));
        } catch (e) {
          console.warn('Could not save script to localStorage', e);
        }

        // 5. Navigate to /teleprompter with query params fallback
        const targetUrl = '/teleprompter?topic=' + encodeURIComponent(topic) +
          '&duration=' + duration +
          '&tone=' + encodeURIComponent(tone);
        
        window.location.href = targetUrl;
      }

      if (btnTransferPrompter) {
        btnTransferPrompter.addEventListener('click', transferToTeleprompter);
      }
      if (btnQuickTransfer) {
        btnQuickTransfer.addEventListener('click', transferToTeleprompter);
      }

      // File Downloader Helper
      function downloadFile(filename, content, type) {
        const blob = new Blob([content], { type: (type || 'text/plain') + ';charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        showToast('Archivo descargado: ' + filename);
      }

      // Export Handlers
      btnExportMd.addEventListener('click', () => {
        if (!currentScript) renderCurrentGeneration();
        recalculateMetrics();
        const slug = currentScript.topic.toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 30);
        let md = '# ' + currentScript.topic + '\\n\\n';
        md += '> **Duración:** ' + currentScript.durationSeconds + 's | **Palabras:** ' + currentScript.totalWords + ' | **Velocidad:** ' + currentScript.overallWPM + ' WPM | **Tono:** ' + currentScript.tone.toUpperCase() + '\\n\\n';
        md += '## Escenas del Video\\n\\n';
        currentScript.scenes.forEach(s => {
          md += '### Escena ' + s.sceneNumber + ': ' + s.name + ' (' + s.timeRange + ')\\n';
          md += '**Locución:**\\n> ' + s.spokenScript + '\\n\\n';
          md += '- 🎬 **Visual:** ' + s.visualCue + '\\n';
          md += '- 🎵 **Audio:** ' + s.soundRhythm + '\\n\\n';
        });
        downloadFile(slug + '-guion.md', md, 'text/markdown');
      });

      btnExportTxt.addEventListener('click', () => {
        if (!currentScript) renderCurrentGeneration();
        recalculateMetrics();
        const slug = currentScript.topic.toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 30);
        let txt = 'TEMA: ' + currentScript.topic + '\\n';
        txt += 'DURACIÓN: ' + currentScript.durationSeconds + 's | PALABRAS: ' + currentScript.totalWords + ' | TONO: ' + currentScript.tone.toUpperCase() + '\\n';
        txt += '===================================================\\n\\n';
        currentScript.scenes.forEach(s => {
          txt += '[' + s.timeRange + '] ESCENA ' + s.sceneNumber + ': ' + s.name.toUpperCase() + '\\n';
          txt += 'LOCUCIÓN: ' + s.spokenScript + '\\n';
          txt += 'VISUAL: ' + s.visualCue + '\\n';
          txt += 'AUDIO: ' + s.soundRhythm + '\\n';
          txt += '---------------------------------------------------\\n';
        });
        downloadFile(slug + '-guion.txt', txt, 'text/plain');
      });

      btnExportJson.addEventListener('click', () => {
        if (!currentScript) renderCurrentGeneration();
        recalculateMetrics();
        const slug = currentScript.topic.toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 30);
        downloadFile(slug + '-guion.json', JSON.stringify(currentScript, null, 2), 'application/json');
      });

      // Update Reactive cURL Snippet
      function updateCurlSnippet() {
        const topic = (inputTopic.value.trim() || 'Stellar Micropayments').replace(/'/g, "\\\\'");
        const dur = sliderDuration.value;
        const tone = selectedTone || 'energetic';
        const snippet = "curl -X POST https://ai-video-scriptwriter.vercel.app/api/script \\\\\\n" +
          "  -H \\\"Content-Type: application/json\\\" \\\\\\n" +
          "  -H \\\"PAYMENT-SIGNATURE: eyJ4NDAyVmVyc2lvbiI6Mi...\\\" \\\\\\n" +
          "  -d '{\\\"topic\\\":\\\"" + topic + "\\\",\\\"durationSeconds\\\":" + dur + ",\\\"tone\\\":\\\"" + tone + "\\\"}'";
        curlTextContent.textContent = snippet;
      }

      btnCopyCurl.addEventListener('click', () => {
        navigator.clipboard.writeText(curlTextContent.textContent).then(() => {
          showToast('Comando cURL copiado al portapapeles');
        });
      });

      // Initial Bootstrap
      renderTopicChips('es');
      renderCurrentGeneration();
      updateCurlSnippet();
    })();
  </script>
</body>
</html>`;
}
